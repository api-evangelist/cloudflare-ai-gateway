{
  "opencollection": "1.0.0",
  "info": {
    "name": "Cloudflare AI Gateway Gateways Logs API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Logs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List request logs for an AI Gateway",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.cloudflare.com/client/v4/accounts/:account_id/ai-gateway/gateways/:gateway_id/logs",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "gateway_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List request logs for an AI Gateway"
        }
      ]
    }
  ],
  "bundled": true
}